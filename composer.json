{
    "name": "starlite/framework",
    "description": "Starlite core: a tiny, database-free PHP micro framework (Datastar, Symfony Routing, Twig, Markdown, Vite), compiled for Opcache.",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "league/commonmark": "^2.8",
        "starfederation/datastar-php": "^1.0",
        "symfony/console": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/yaml": "^7.4",
        "twig/twig": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Starlite\\": "src/"
        }
    }
}
