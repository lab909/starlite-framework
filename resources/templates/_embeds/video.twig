{#
    The look of the default video components (youtube, vimeo): copy it to templates/_embeds/video.twig
    in the site to restyle both.

    Click-to-load: the page shows a poster this site serves itself (downloaded by `deploy`) and the
    iframe has no src until the visitor presses play, so nothing reaches the video host before that.
    Datastar then copies data-src into src; video() has allowed the player in this page's frame-src.
    Without JavaScript the poster is a link to the video's own page.
#}
{% set label = title ?? video.title ?? video.name %}
{% set signal = '_video_' ~ video.provider ~ '_' ~ video.id|replace({'-': '_'}) %}
<figure class="not-prose my-8" data-signals="{ {{ signal }}: false }">
    <div class="relative aspect-video overflow-hidden rounded-lg bg-stone-900">
        <iframe data-src="{{ video.src }}" data-attr:src="${{ signal }} ? el.dataset.src : false"
                data-show="${{ signal }}" style="display: none" title="{{ label }}"
                allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin" class="absolute inset-0 size-full border-0"></iframe>
        <a href="{{ video.url }}" data-show="!${{ signal }}" data-on:click__prevent="${{ signal }} = true"
           aria-label="{{ 'Play video: {title}'|t({title: label}) }}"
           class="group absolute inset-0 flex items-center justify-center focus-visible:outline-none">
            {% if video.poster %}
                <img src="{{ video.poster }}" alt="" loading="lazy" class="absolute inset-0 size-full object-cover">
            {% else %}
                <span class="absolute inset-0 bg-gradient-to-br from-stone-700 to-stone-950"></span>
            {% endif %}
            <span class="relative flex size-16 items-center justify-center rounded-full bg-black/70 text-white transition group-hover:scale-105 group-hover:bg-black/85 group-focus-visible:ring-4 group-focus-visible:ring-white">
                <span class="icon-[lucide--play] size-7 translate-x-0.5" aria-hidden="true"></span>
            </span>
        </a>
    </div>
    <figcaption class="mt-2 text-sm opacity-75">
        {% if label != video.name %}{{ label }} · {% endif %}{{ 'Plays from {host}: nothing is loaded from it until you press play.'|t({host: video.name}) }}
    </figcaption>
</figure>
